# API keys and OAuth logins in ~/.pi/agent/auth.json are reused automatically.
# Copy to .env only if you prefer an environment key or custom interface.
GAME_AGENT_MODE=demo
GAME_MODEL_PROVIDER=deepseek
# Any provider with chat models in pi-ai's built-in catalog can be selected.
# Examples: openai, anthropic, google, openrouter, groq.
# Omit GAME_MODEL_ID to select the current pi catalog default.
# GAME_MODEL_ID=deepseek-flash
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GAME_MODEL_API_KEY=
# Custom Chat Completions endpoint (including /v1 where required).
# GAME_MODEL_PROVIDER=compatible
# GAME_MODEL_ID=your-model-id
# GAME_MODEL_BASE_URL=https://your-provider.example/v1
GAME_MODEL_TIMEOUT_MS=30000
GAME_MODEL_MAX_TOKENS=2000
